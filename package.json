{
  "name": "sinequa-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server over the published documentation of @sinequa/atomic, @sinequa/atomic-angular and @sinequa/galactik",
  "type": "module",
  "bin": {
    "sinequa-docs-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "tsx src/cli.ts",
    "start:http": "tsx src/cli.ts --http",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "bundle": "node scripts/bundle.mjs",
    "pack:bundle": "npm run bundle && node scripts/pack-bundle.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebus/sinequa-docs-mcp.git"
  }
}
